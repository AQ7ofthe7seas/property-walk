          animate={{ opacity: 1 }}
          onClick={onClose}
          role="presentation"
        >
          <motion.div
            role="dialog"
            aria-modal="true"
            aria-labelledby="pricing-modal-title"
            className="glass-gold relative w-full max-w-md overflow-hidden rounded-2xl p-8"
            style={{ "--glow-pos": "80% -10%" } as React.CSSProperties}
